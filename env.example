# ─────────────────────────────────────────────────────────────────────────────
# Shared configuration for both access paths.
#
#   cp env.example env && chmod 600 env && $EDITOR env
#
# `env` is gitignored: it names internal hosts and, for the SSO path, holds a
# client secret. Every script sources it and refuses to run on placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── The app you want to reach (private, inside the FLEX tenant network) ──────
APP_PRIVATE_IP="10.0.0.0"          # e.g. 10.20.30.40
APP_PORT="5001"
APP_SCHEME="http"                  # http | https  (how the proxy talks to it)

# ── The jumphost / proxy VM (the only machine with a floating IP) ────────────
BASTION_USER="jump"                # unprivileged tunnel account, created by setup
BASTION_FLOATING_IP="0.0.0.0"      # the FLEX floating IP on this VM
BASTION_SSH_PORT="22"

# Who may reach the bastion at all. NEVER 0.0.0.0/0 — this is the outer gate.
# Ask your network team for the office / corporate VPN egress range.
COMPANY_CIDR="203.0.113.0/24"

# ── SSO path only ────────────────────────────────────────────────────────────
PUBLIC_HOSTNAME="app.example.com"  # DNS A record -> BASTION_FLOATING_IP
LETSENCRYPT_EMAIL="you@rackspace.com"

# Shown on the branded sign-in page.
APP_NAME="FLEX Migration Hub"
ORG_NAME="Rackspace"

# Microsoft Entra ID application registration.
# See ../cloudmax/docs/SSO_MICROSOFT_ENTRA.md for how to create it.
ENTRA_TENANT_ID="<TENANT_ID>"
ENTRA_CLIENT_ID="<APPLICATION_CLIENT_ID>"
ENTRA_CLIENT_SECRET="<CLIENT_SECRET_VALUE>"
ALLOWED_EMAIL_DOMAIN="rackspace.com"
# Optional, tighter than a whole domain: only members of this Entra group.
ALLOWED_GROUP_ID=""

# ── OpenStack provisioning only (source your OpenRC separately) ──────────────
OS_EXTERNAL_NETWORK="PUBLICNET"
OS_TENANT_NETWORK="my-tenant-net"
OS_IMAGE="Ubuntu 22.04"
OS_FLAVOR="gp.0.1.2"
OS_KEYPAIR="my-keypair"
