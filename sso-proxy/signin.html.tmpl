<!doctype html>
<!--
  Branded sign-in landing page.

  This page deliberately has NO password field. It hands off to Microsoft, which
  collects the credential and runs MFA / Conditional Access. Three reasons that
  matters, in order of how much they would hurt:

    1. A password typed here would be readable by this server. Anything it holds
       it can leak.
    2. Authenticator, device compliance and risk-based policies cannot run
       through a proxied form — you would silently lose MFA.
    3. Staff who learn to type company credentials into a non-Microsoft page are
       the reason phishing works.

  Rendered by setup-sso-proxy.sh; ${...} are substituted there.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Sign in · ${APP_NAME}</title>
<style>
  :root {
    --bg:#0b1220; --card:#111a2e; --line:#1e2b45;
    --fg:#eaf0fb; --dim:#93a4c0; --blue:#2563eb; --blue-h:#1d4ed8;
  }
  * { box-sizing:border-box; }
  body {
    margin:0; min-height:100vh; display:grid; place-items:center;
    background:
      radial-gradient(1100px 500px at 50% -12%, #16233d 0%, transparent 60%),
      var(--bg);
    color:var(--fg);
    font:15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    padding:24px;
  }
  .card {
    width:100%; max-width:420px; background:var(--card);
    border:1px solid var(--line); border-radius:16px; padding:36px 32px 28px;
    box-shadow:0 24px 60px -24px rgba(0,0,0,.7);
  }
  .badge {
    display:inline-flex; align-items:center; gap:8px; margin-bottom:22px;
    padding:6px 13px; border-radius:999px;
    border:1px solid rgba(37,99,235,.4); background:rgba(37,99,235,.12);
    font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;
    color:#93b4fb;
  }
  .badge i { width:7px; height:7px; border-radius:50%; background:var(--blue); }
  h1 { margin:0 0 8px; font-size:23px; font-weight:700; letter-spacing:-.01em; }
  p.sub { margin:0 0 26px; color:var(--dim); font-size:14px; }
  .btn {
    display:flex; align-items:center; justify-content:center; gap:11px;
    width:100%; padding:13px 18px; border:0; border-radius:10px;
    background:var(--blue); color:#fff; font-size:15px; font-weight:600;
    text-decoration:none; cursor:pointer; transition:background .15s;
  }
  .btn:hover { background:var(--blue-h); }
  .btn svg { flex:none; }
  .note {
    margin-top:20px; padding-top:18px; border-top:1px solid var(--line);
    color:var(--dim); font-size:12.5px;
  }
  .note b { color:#c3d2ea; font-weight:600; }
  .err {
    margin:0 0 20px; padding:11px 14px; border-radius:9px;
    border:1px solid rgba(239,68,68,.36); background:rgba(239,68,68,.11);
    color:#fca5a5; font-size:13px; display:none;
  }
  .foot { margin-top:18px; text-align:center; color:#5b6b87; font-size:11.5px; }
</style>
</head>
<body>
  <main class="card">
    <div class="badge"><i></i>${ORG_NAME}</div>

    <div class="err" id="err"></div>

    <h1>${APP_NAME}</h1>
    <p class="sub">Sign in with your company account to continue.</p>

    <a class="btn" id="go" href="/oauth2/start">
      <!-- Microsoft mark -->
      <svg width="18" height="18" viewBox="0 0 23 23" aria-hidden="true">
        <rect width="10" height="10" x="1"  y="1"  fill="#f25022"/>
        <rect width="10" height="10" x="12" y="1"  fill="#7fba00"/>
        <rect width="10" height="10" x="1"  y="12" fill="#00a4ef"/>
        <rect width="10" height="10" x="12" y="12" fill="#ffb900"/>
      </svg>
      Sign in with Microsoft
    </a>

    <p class="note">
      You will enter your password on <b>login.microsoftonline.com</b> and approve
      the Authenticator prompt. This site never sees your password.
    </p>

    <p class="foot">Access is limited to @${ALLOWED_EMAIL_DOMAIN} accounts.</p>
  </main>

<script>
  // Carry the page the user originally wanted through the sign-in, so they land
  // back on it rather than on the site root.
  (function () {
    var q = new URLSearchParams(location.search);
    var rd = q.get('rd') || '';
    // Only same-site paths. An absolute URL here would make this page an open
    // redirect that phishing could point anywhere.
    if (/^\/(?!\/)/.test(rd)) {
      document.getElementById('go').href = '/oauth2/start?rd=' + encodeURIComponent(rd);
    }
    var msg = {
      denied: 'Your account is not permitted to open this application. ' +
              'Ask the owner to add you to the access group.',
      expired: 'Your session expired. Sign in again to continue.'
    }[q.get('e')];
    if (msg) {
      var e = document.getElementById('err');
      e.textContent = msg;
      e.style.display = 'block';
    }
  })();
</script>
</body>
</html>
